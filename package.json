{
  "name": "ekeko",
  "displayName": "Ekeko",
  "description": "Query and explore Java code with Ekeko's logic-programming query engine,.",
  "version": "0.0.4",
  "publisher": "vdb",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "redhat.java",
    "betterthantomorrow.calva"
  ],
  "contributes": {
    "javaExtensions": [
      "./server/damp.ekeko.jdtls.jar"
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "ekeko",
          "title": "Ekeko",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ekeko": [
        {
          "type": "webview",
          "id": "ekeko.resultsView",
          "name": "Results"
        }
      ]
    },
    "commands": [
      {
        "command": "ekeko.command.rebuildModel",
        "title": "Rebuild Model",
        "category": "Ekeko"
      },
      {
        "command": "ekeko.command.startRepl",
        "title": "Start REPL",
        "category": "Ekeko"
      },
      {
        "command": "ekeko.command.stopRepl",
        "title": "Stop REPL",
        "category": "Ekeko"
      }
    ],
    "configuration": {
      "title": "Ekeko",
      "properties": {
        "ekeko.queryTimeout": {
          "type": "number",
          "default": 5000,
          "minimum": 0,
          "description": "Query timeout (in ms), set to 0 to disable."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "build-server": "./scripts/build-server.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "license": "EPL-1.0"
}
